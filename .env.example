# The subnet the Tuya devices live on. The bridge searches it for them.
TUYA_SUBNET=192.168.1.0/24

# Cloud project credentials, needed only until the enrolment is stored:
# Tuya IoT Platform -> Cloud -> Development -> your project -> Authorization Key.
TUYA_ACCESS_ID=
TUYA_ACCESS_KEY=

# Phone country code of the Smart Life / Tuya Smart account linked to the cloud
# project. It selects the Tuya data center.
TUYA_COUNTRY_CODE=55

# Optional. Overrides the data center, e.g. https://openapi.tuyaus.com
TUYA_ENDPOINT=

# Optional. Seconds between readings.
TUYA_POLL_INTERVAL=30

# Optional. Port of the web page that lists the devices.
TUYA_WEB_PORT=8080

# Optional. Files that store which devices are exposed, and what it takes to
# reach them. They default to sitting beside the Matter state.
TUYA_STATE_FILE=
TUYA_ENROLLMENT_FILE=

# Optional. Matter commissioning data.
MATTER_PASSCODE=20202021
MATTER_DISCRIMINATOR=3840
MATTER_PORT=5540
