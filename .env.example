# Cloud project credentials: Tuya IoT Platform -> Cloud -> Development -> your
# project -> Overview -> Authorization Key.
ACCESS_ID=
ACCESS_KEY=

# Phone country code of the Smart Life / Tuya Smart account linked to the cloud
# project. It selects the Tuya data center.
COUNTRY_CODE=55

# Optional. Overrides the data center, e.g. https://openapi.tuyaus.com
TUYA_ENDPOINT=

# Optional. Seconds between Tuya cloud reads.
POLL_INTERVAL=30

# Optional. Matter commissioning data.
MATTER_PASSCODE=20202021
MATTER_DISCRIMINATOR=3840
MATTER_PORT=5540
